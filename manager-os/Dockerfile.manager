# syntax=docker/dockerfile:1.7
#
# Multi-stage build with BuildKit cache mounts.
#
# The service has no C dependencies: actix-web runs with default-features
# disabled and the resulting binary only links against libc, libgcc_s and
# libm. Only the aarch64 cross linker is required, not a full toolchain.
#
# The registry and target directories are cache mounts, so dependencies and
# intermediate artifacts survive between builds instead of being downloaded
# and recompiled every time.

FROM rust:1.90.0-slim-bookworm AS builder
# gcc-aarch64-linux-gnu only *recommends* the aarch64 C runtime: with
# --no-install-recommends, libc6-dev-arm64-cross (Scrt1.o, crti.o, libc) must
# be listed explicitly or the cross link fails on x86_64 hosts.
RUN apt-get update && apt-get install --no-install-recommends -y \
      gcc-aarch64-linux-gnu \
      libc6-dev-arm64-cross \
  && rm -rf /var/lib/apt/lists/* \
  && rustup target add aarch64-unknown-linux-gnu
# On an x86_64 build host cargo must link with the aarch64 cross linker (the
# host `cc` fails). On an arm64 host (Apple Silicon) the native `cc` already
# targets aarch64, so nothing is configured.
RUN if [ "$(dpkg --print-architecture)" != "arm64" ]; then \
      printf '[target.aarch64-unknown-linux-gnu]\nlinker = "aarch64-linux-gnu-gcc"\n' \
        >> "${CARGO_HOME:-/usr/local/cargo}/config.toml"; \
    fi
WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    cargo build --release --target aarch64-unknown-linux-gnu \
    && cp /app/target/aarch64-unknown-linux-gnu/release/wifi_setup_service /wifi_setup_service

# The final image is only used as a carrier for the binary
# (docker create + docker cp), it is never executed.
# The CMD is required so `docker create` works without an explicit command.
FROM scratch
COPY --from=builder /wifi_setup_service /wifi_setup_service
CMD ["/wifi_setup_service"]
