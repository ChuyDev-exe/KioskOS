# Development device configuration.
#
# Copy this file and adjust the values:
#   cp scripts/dev.env.example scripts/dev.env
#
# It is sourced by the dev-* scripts, so it must be valid shell.

# Hostname or IP address of the target Raspberry Pi.
PI_HOST=192.168.1.50

# SSH user of the target device: device.user1 in kiosk_os/config/adagi_os.yaml.
# It needs passwordless sudo for dev-sync-app.sh (install + restart).
PI_USER=adagio

# SSH port.
PI_PORT=22

# systemd unit names, only change them if you renamed the services.
WIFI_SERVICE=wifi_setup.service
KIOSK_SERVICE=kiosk.service
